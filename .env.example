## Redis (optional)
# Leave REDIS_URL unset if you do not want caching.
REDIS_URL=

## AniList
GRAPHQL_ENDPOINT=https://graphql.anilist.co
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

## NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-kage-domain.vercel.app

## MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/kage

## Playback provider (optional)
# Kage expects a provider-neutral, ReAnime-style HTTP API:
#   GET /anime/:anilistId/episodes
#   GET /anime/:anilistId/:episode/:audio
#
# If this is unset, Kage still loads episode metadata from AniZip/AniList,
# but playback links remain disabled.
KAGE_MEDIA_API_URL=

# Optional Bearer token for a private media API.
KAGE_MEDIA_API_TOKEN=

## AniList OAuth callback
# Add this redirect URL in the AniList Developer console:
# https://your-kage-domain.vercel.app/api/auth/callback/AniListProvider
