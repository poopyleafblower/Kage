## Redis (optional)
# Leave REDIS_URL unset if you do not want caching.
REDIS_URL=

## AniList
GRAPHQL_ENDPOINT=https://graphql.anilist.co
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

## NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-kage-domain.vercel.app

## MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/kage

## Playback
# ReAnime is integrated directly into Kage. No separate API deployment or token is required.
# Override this only if you have an alternate ReAnime-compatible base domain.
REANIME_BASE_URL=https://reanime.to

# Optional custom media API fallback. Leave unset for the built-in ReAnime provider.
KAGE_MEDIA_API_URL=
KAGE_MEDIA_API_TOKEN=

## AniList OAuth callback
# Add this redirect URL in the AniList Developer console:
# https://your-kage-domain.vercel.app/api/auth/callback/AniListProvider
